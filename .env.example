APP_NAME=NunaBooks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nunabooks
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seed invented demo shop data. Refused when APP_ENV=production.
SEED_DEMO_DATA=false

# Read the caller's address from X-Forwarded-For only behind a proxy that overwrites it.
NUNA_TRUST_PROXY_HEADERS=false
# First-run setup answers only the shop PC itself. true: anyone on the network can claim the owner account.
NUNA_SETUP_FROM_LAN=false
# The old app's live data file, which nuna:import-sqlite and nuna:reconcile refuse to read (copy it
# while the old app is stopped, and import the copy). On the shop PC, point this at the old app's real
# data file wherever it is installed there.
NUNA_OLD_LIVE_DATABASE=C:\ClaudeProjects\bookkeeper\data\bookkeeper.db
# Folder with mysqldump.exe and mysql.exe (default: newest C:\laragon\bin\mysql\*\bin).
# NUNA_MYSQL_BIN=C:\laragon\bin\mysql\mysql-8.4.0-winx64\bin
# NUNA_BACKUP_DIR=E:\NunaBooks-backups
NUNA_BACKUP_KEEP=14
